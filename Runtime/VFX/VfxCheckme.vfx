  m_Script: {fileID: 11500000, guid: 3dce580c03fa4404bb6d87662050fbf1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Operator.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966674976}
  m_Children: []
  m_UIPosition: {x: 2560, y: 1866}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661615318}
  - {fileID: 8926484042661615322}
  - {fileID: 8926484042661615323}
  m_OutputSlots:
  - {fileID: 8926484042661615327}
  m_OperatorName: CalculateSdfUvw
  m_HLSLCode: "float3 Uvw(in float3 PositionWS, float4x4 WorldToLocal, float3 VolumeSize)\r\n    {\r\n        // Trasforma la posizione World Space della particella nello spazio locale dell'SDF\r\n        float3 localPos = mul(WorldToLocal, float4(PositionWS, 1.0)).xyz;\r\n\r\n        // Converte la coordinata locale (che spazia da -Size/2 a +Size/2) in coordinate [0, 1] per la texture 3D\r\n        float3 UVW = (localPos / VolumeSize) + 0.5;\r\n\r\n        return UVW;\r\n    }"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunctions:
    selection: Uvw
    selectedIndex: 0
